        "must_exhaust_any": ["coi_top.pure_comb_o"],
        "min_satisfied": 1,
        "max_ff_in_coi": 1
      }
    },
    {
      "id": "coi_ladder_ff2",
      "until": "FF:2",
      "expect": {
        "why": "2nd FF: s1 + fork arms; block 3rd FF and dead forest",
