          "coi_top.dead_q",
          "coi_top.dead_o"
        ],
        "must_exhaust_any": [
          "coi_top.pure_comb_o",
          "coi_top.short_o"
        ],
        "min_satisfied": 2,
        "max_ff_in_coi": 2
      }
    },
    {
      "id": "coi_ladder_ff3",
      "until": "FF:3",
      "expect": {
        "why": "3rd FF reaches deep_o; dead still isolated",
        "must_satisfy": [
          "coi_top.u_s2.q_o",
          "coi_top.s2_q",
