      "until": "FF:2",
      "direction": "fanin",
      "a": ["coi_top.deep_o"],
      "expect": {
        "why": "fan-in deep_o: reverse 2 proc (s2 then s1) lands at u_s1.d_i / s0_w aliases; dead isolated; a_i not yet (needs 3rd FF reverse)",
        "must_satisfy": [
          "coi_top.u_s1.d_i",
          "coi_top.s0_w",
          "coi_top.u_s0.q_o"
        ],
        "must_not_coi": [
          "coi_top.dead_o",
