{
  // Company-style run config: many +define+ / env without stuffing the CLI.
  //   python3 build_db.py --config run_build_db.json
  // Paths are relative to this JSON file's directory.
  //
  // env: variables used inside .f (and path fields): $PROJ, ${RTL_ROOT}/...
  // Same idea as hierwalk run JSON "env" block.

  "filelist": "filelist.f",
  "top": "top",
  "cwd": ".",

  "env": {
    // "PROJ": "/proj/chip",
    // "RTL_ROOT": "/proj/chip/rtl"
  },

  "defines": {
    "FEATURE_A": "1"
    // "SYNTHESIS": "1",
    // "TECH_NODE": "N3",
    // "FIFO_DEPTH": "32"
  },

  "build_db": {
    "output": "work/essential.sqlite",
    "work_dir": "work",
    // "fast" = parallel name scan (default; use at company scale)
    // "pyslang" = full parse — accurate but often 10–40+ min on large RTL
    "mode": "fast",
    "scan_workers": 8
  }
}
